generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mapeamento dinâmico de funções
enum Role {
  SUPER_ADMIN      // Pastores e Diretoria Executiva
  ADMIN_WELCOME    // Liderança do Acolhimento / Integração
  GC_SUPERVISOR    // Supervisor de Grupos de Conexão
  GC_LEADER        // Líder de GC
  WORSHIP_LEADER   // Líder de Louvor
  MEMBER           // Membro Comum (acesso restrito)
}

enum MaritalStatus {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
}

enum VisitorStatus {
  PENDENTE
  EM_CONSOLIDACAO
  MEMBRO
  INATIVO
}

// Usuários do APP (Líderes, Pastores, Membros Ativos)
model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  roles     Role[]   // Array permitindo acumular múltiplos cargos
  isActive  Boolean  @default(true)
  
  // Relacionamentos: O que esse usuário fez/gerencia?
  visitorsRegistered  Visitor[] @relation("RegisteredBy")
  convertedVisitors   Visitor[] @relation("ConvertedVisitor")
  gcsLed              ConnectionGroup[] @relation("GCLeader")
  memberProfile       MemberProfile?

  // ADICIONADO: Qual Grupo de Conexão este membro frequenta (como participante, não como líder)
  connectionGroupId   String?
  connectionGroup     ConnectionGroup? @relation("GCMembers", fields: [connectionGroupId], references: [id])
  attendanceReports   ServiceAttendance[] @relation("CreatedAttendance")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cadastro de Visitantes
model Visitor {
  id              String         @id @default(uuid())
  fullName        String
  email           String?
  phone           String?
  maritalStatus   MaritalStatus?
  birthDate       DateTime?      // Melhor que salvar a idade fixa
  isBaptized      Boolean        @default(false)
  neighborhood    String?
  fullAddress     String?
  wantsToJoinGC   Boolean        @default(false)
  howDidYouArrive String?        // Ex: "Convite de Amigo", "Redes Sociais", etc
  visitDate       DateTime       @default(now())
  
  status          VisitorStatus  @default(PENDENTE)
  
  // ADICIONADO: @unique colocado aqui, pois uma ficha de visitante só pode gerar UM membro
  userId          String?        @unique 
  user            User?          @relation("ConvertedVisitor", fields: [userId], references: [id])
  
  // Quem fez o cadastro no aplicativo (Rastreabilidade)
  registeredById  String?        // CORREÇÃO: O @unique foi removido daqui para o líder poder cadastrar vários visitantes
  registeredBy    User?          @relation("RegisteredBy", fields: [registeredById], references: [id])
  
  // ADICIONADO: Para visitantes que já começaram a frequentar um GC antes de virar membro
  connectionGroupId String?
  connectionGroup   ConnectionGroup? @relation("GCVisitors", fields: [connectionGroupId], references: [id])
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// Grupos de Conexão (GCs / Células)
model ConnectionGroup {
  id           String   @id @default(uuid())
  name         String   // Ex: "GC Filhos do Rei"
  neighborhood String?
  meetingDay   String?  // Ex: "Terça-feira"
  meetingTime  String?  // Ex: "19:30"
  
  // Líder responsável pelo GC
  leaderId     String?
  leader       User?    @relation("GCLeader", fields: [leaderId], references: [id])

  // ADICIONADO: Listas de quem frequenta este GC (Membros e Visitantes)
  members      User[]   @relation("GCMembers")
  visitors     Visitor[] @relation("GCVisitors")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Perfil detalhado de Membros
model MemberProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  phone           String?
  address         String?
  zipCode         String?
  neighborhood    String?
  birthDate       DateTime?
  joinDate        DateTime?
  baptismDate     DateTime?
  ministries      String[]
  
  // ADICIONADO: Campos comuns para estatísticas da membresia da igreja
  maritalStatus   MaritalStatus?
  gender          String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Cargos e Ministérios cadastrados na Igreja
model Ministry {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Frequência de Pessoas e Lançamento de Cultos da Igreja
model ServiceAttendance {
  id              String   @id @default(uuid())
  date            DateTime
  serviceName     String
  attendanceCount Int
  notes           String?

  createdById     String?
  createdBy       User?    @relation("CreatedAttendance", fields: [createdById], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}