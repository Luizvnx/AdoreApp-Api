generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mapeamento dinâmico de funções
enum Role {
  SUPER_ADMIN      // Pastores e Diretoria Executiva
  PASTOR           // Pastor Local (Administrador da Filial)
  DIRECTOR         // Diretoria Auxiliar (Acesso limitado em áreas críticas como finanças)
  FINANCE_ADMIN    // Tesouraria / Administração Financeira
  ADMIN_WELCOME    // Liderança do Acolhimento / Integração
  GC_SUPERVISOR    // Supervisor de Grupos de Conexão
  GC_LEADER        // Líder de GC
  WORSHIP_LEADER   // Líder de Louvor
  MEMBER           // Membro Comum (acesso restrito)
}

enum MaritalStatus {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
}

enum VisitorStatus {
  PENDENTE
  EM_CONSOLIDACAO
  MEMBRO
  INATIVO
}

// Model para Congregações (Sede e Filiais)
model Congregation {
  id            String    @id @default(uuid())
  name          String    // Ex: "Sede Central (Matriz)", "Filial Jardim América"
  address       String?
  phone         String?
  foundedAt     DateTime?
  isHeadquarter Boolean   @default(false)

  // Relacionamentos com os módulos
  users                 User[]
  visitors              Visitor[]
  connectionGroups      ConnectionGroup[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]
  fixedExpenses         FixedExpense[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Usuários do APP (Líderes, Pastores, Membros Ativos)
model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  roles     Role[]   // Array permitindo acumular múltiplos cargos
  isActive  Boolean  @default(true)
  
  // Vínculo com a Congregação
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id])

  // Relacionamentos: O que esse usuário fez/gerencia?
  visitorsRegistered  Visitor[] @relation("RegisteredBy")
  convertedVisitors   Visitor[] @relation("ConvertedVisitor")
  gcsLed              ConnectionGroup[] @relation("GCLeader")
  memberProfile       MemberProfile?

  // ADICIONADO: Qual Grupo de Conexão este membro frequenta (como participante, não como líder)
  connectionGroupId   String?
  connectionGroup     ConnectionGroup? @relation("GCMembers", fields: [connectionGroupId], references: [id])
  attendanceReports   ServiceAttendance[] @relation("CreatedAttendance")

  // ADICIONADO: Relacionamentos Financeiros
  financialTransactions FinancialTransaction[] @relation("CreatedTransactions")
  editedTransactions    FinancialTransaction[] @relation("EditedTransactions")
  fixedExpenses         FixedExpense[]         @relation("CreatedFixedExpenses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cadastro de Visitantes
model Visitor {
  id              String         @id @default(uuid())
  fullName        String
  email           String?
  phone           String?
  maritalStatus   MaritalStatus?
  birthDate       DateTime?      // Melhor que salvar a idade fixa
  isBaptized      Boolean        @default(false)
  neighborhood    String?
  fullAddress     String?
  wantsToJoinGC   Boolean        @default(false)
  howDidYouArrive String?        // Ex: "Convite de Amigo", "Redes Sociais", etc
  visitDate       DateTime       @default(now())
  
  status          VisitorStatus  @default(PENDENTE)

  // Vínculo com a Congregação
  congregationId  String?
  congregation    Congregation?  @relation(fields: [congregationId], references: [id])
  
  // ADICIONADO: @unique colocado aqui, pois uma ficha de visitante só pode gerar UM membro
  userId          String?        @unique 
  user            User?          @relation("ConvertedVisitor", fields: [userId], references: [id])
  
  // Quem fez o cadastro no aplicativo (Rastreabilidade)
  registeredById  String?        // CORREÇÃO: O @unique foi removido daqui para o líder poder cadastrar vários visitantes
  registeredBy    User?          @relation("RegisteredBy", fields: [registeredById], references: [id])
  
  // ADICIONADO: Para visitantes que já começaram a frequentar um GC antes de virar membro
  connectionGroupId String?
  connectionGroup   ConnectionGroup? @relation("GCVisitors", fields: [connectionGroupId], references: [id])
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// Grupos de Conexão (GCs / Células)
model ConnectionGroup {
  id           String   @id @default(uuid())
  name         String   // Ex: "GC Filhos do Rei"
  neighborhood String?
  meetingDay   String?  // Ex: "Terça-feira"
  meetingTime  String?  // Ex: "19:30"
  
  // Vínculo com a Congregação
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id])

  // Líder responsável pelo GC
  leaderId     String?
  leader       User?    @relation("GCLeader", fields: [leaderId], references: [id])

  // ADICIONADO: Listas de quem frequenta este GC (Membros e Visitantes)
  members      User[]   @relation("GCMembers")
  visitors     Visitor[] @relation("GCVisitors")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Perfil detalhado de Membros
model MemberProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  phone           String?
  address         String?
  zipCode         String?
  neighborhood    String?
  birthDate       DateTime?
  joinDate        DateTime?
  baptismDate     DateTime?
  ministries      String[]
  
  // ADICIONADO: Campos comuns para estatísticas da membresia da igreja
  maritalStatus   MaritalStatus?
  gender          String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Cargos e Ministérios cadastrados na Igreja
model Ministry {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Frequência de Pessoas e Lançamento de Cultos da Igreja
model ServiceAttendance {
  id              String   @id @default(uuid())
  date            DateTime
  serviceName     String
  attendanceCount Int
  notes           String?

  createdById     String?
  createdBy       User?    @relation("CreatedAttendance", fields: [createdById], references: [id])

  transactions    FinancialTransaction[] @relation("ServiceTransactions")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Módulo Financeiro
enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  DIZIMO_OFERTA
  DOACAO
  EVENTOS
  GASTO_FIXO
  GASTO_VARIAVEL
  MANUTENCAO
  OUTROS
}

enum PaymentMethod {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
  TRANSFERENCIA
  OUTRO
}

// Model para Caixa Principal/Missões/etc (Prepara para futuros múltiplos caixas)
model FinancialAccount {
  id          String   @id @default(uuid())
  name        String   @unique // Ex: "Caixa Geral"
  description String?
  balance     Float    @default(0.0)
  
  // Vínculo com a Congregação
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id])

  transactions FinancialTransaction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinancialTransaction {
  id              String   @id @default(uuid())
  title           String   // Ex: Oferta de Domingo, Conta de Luz
  type            TransactionType
  amount          Float
  date            DateTime
  category        TransactionCategory
  paymentMethod   PaymentMethod @default(PIX)
  notes           String?
  
  // Vínculo com a Congregação
  congregationId  String?
  congregation    Congregation? @relation(fields: [congregationId], references: [id])

  // Vínculo a qual caixa pertence
  accountId       String
  account         FinancialAccount @relation(fields: [accountId], references: [id])

  // Opcional: Vincular uma arrecadação a um culto específico
  serviceId       String?
  service         ServiceAttendance? @relation("ServiceTransactions", fields: [serviceId], references: [id])

  createdById     String?
  createdBy       User?    @relation("CreatedTransactions", fields: [createdById], references: [id])

  editedById      String?
  editedBy        User?    @relation("EditedTransactions", fields: [editedById], references: [id])
  editHistory     Json?    // Array de objetos { editedAt, editedBy, changes }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FixedExpense {
  id              String   @id @default(uuid())
  title           String
  amount          Float
  dueDate         Int      // Dia de vencimento no mês (1-31)
  isActive        Boolean  @default(true)
  notes           String?

  // Vínculo com a Congregação
  congregationId  String?
  congregation    Congregation? @relation(fields: [congregationId], references: [id])

  createdById     String?
  createdBy       User?    @relation("CreatedFixedExpenses", fields: [createdById], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}